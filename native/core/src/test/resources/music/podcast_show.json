sicConfig":{"musicVideoType":"MUSIC_VIDEO_TYPE_PODCAST_EPISODE"}}}},"playIcon":{"iconType":"PLAY_ARROW"},"pauseIcon":{"iconType":"PAUSE"},"iconColor":4294967295,"backgroundColor":0,"activeBackgroundColor":0,"loadingIndicatorColor":14745645,"playingIcon":{"iconType":"VOLUME_UP"},"iconLoadingColor":0,"activeScaleFactor":1,"buttonSize":"MUSIC_PLAY_BUTTON_SIZE_SMALL","rippleTarget":"MUSIC_PLAY_BUTTON_RIPPLE_TARGET_SELF","accessibilityPlayData":{},"accessibilityPauseData":{}}},"contentPosition":"MUSIC_ITEM_THUMBNAIL_OVERLAY_CONTENT_POSITION_CENTERED","displayStyle":"MUSIC_ITEM_THUMBNAIL_OVERLAY_DISPLAY_STYLE_PERSISTENT"}},"onTap":{"watchEndpoint":{"videoId":"kTSnYNClAao","params":"8gEDmAEI","watchEndpointMusicSupportedConfigs":{"watchEndpointMusicConfig":{"musicVideoType":"MUSIC_VIDEO_TYPE_PODCAST_EPISODE"}}}},"subtitle":{"runs":[{"text":"18K views"},{"text":" • "},{"text":"Aug 31"}]},"playbackProgress":{"musicPlaybackProgressRenderer":{"playbackProgressPercentage":0,"playbackProgressText":{"runs":[{"text":" • "},{"text":"29 min"}]},"videoPlaybackPositionFeedbackToken":"AB9zfpL8NnbdK0pVBKKh6h_Zv4raGRcVF1zgeVXMTw05ed1ZR092mpkd8ZIAxPzsTfENJXD8SOOC8_PnBIW32rcR4Etdfdfa0A","durationText":{"runs":[{"text":" • "},{"text":"29 min"}]},"playedText":{"runs":[{"text":" • "},{"text":"Played","textColor":4294921797}]}}},"title":{"runs":[{"text":"E199 Et si on se rencontrait ?","navigationEndpoint":{"browseEndpoint":{"browseId":"MPEDkTSnYNClAao","browseEndpointContextSupportedConfigs":{"browseEndpointContextMusicConfig":{"pageType":"MUSIC_PAGE_TYPE_NON_MUSIC_AUDIO_TRACK_PAGE"}}}}}]},"description":{"runs":[{"text":"Apprendre une langue derrière un écran, c'est pratique. Mais il manque souvent un ingrédient essentiel : la rencontre en chair et en os, ces moments où l’on pratique la langue en vivant quelque chose ensemble.\n\n\n\nGrâce à ses nombreux voyages, Ingrid a souvent eu l'occasion de vivre ce genre d'expériences inoubliables. Au fil des années, une idée a germé : et si elle pouvait proposer la même chose aux personnes qui apprennent le français ?\n\n\n\nDans cet épisode, Ingrid vous dévoile le projet qu'elle est en train de concrétiser dans sa ville d'adoption, Toulouse, pour vous offrir des expériences inoubliables en français.\n\n\n\nTranscription de l'épisode (https://innerfrench.com/199-et-si-on-se-rencontrait/?utm_source=podcast&utm_medium=organic&utm_campaign=transcript&utm_content=e199) \n\n\n\nhttps://niddouillethostel.com"}]},"displayStyle":"MUSIC_MULTI_ROW_LIST_ITEM_DISPLAY_STYLE_DETAILED"}},{"musicMultiRowListItemRenderer":{"thumbnail":{"musicThumbnailRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/N1eYmYiNXYo/sddefault.jpg?sqp=-oaymwElCIAFEOgCIAQqCghQELAEGAAg4ANIWvKriqkDCZoCBggzECMYJg&rs=AMzJL3mMgllNrh9Bp678M8cfhuNaohMnnQ","width":640,"height":360},{"url":"https://i.ytimg.com/vi/N1eYmYiNXYo/hq720.jpg?sqp=-oaymwEmCIAKENAFIAQqCwiYAhDoBxgAINAFSFryq4qpAwmaAgYIMxAjGCY&rs=AMzJL3lIlDlnN1g_ZjGQNPStoxCcHK_VmQ","width":1280,"height":720}]},"thumbnailCrop":"MUSIC_THUMBNAIL_CROP_UNSPECIFIED","thumbnailScale":"MUSIC_THUMBNAIL_SCALE_ASPECT_FIT"}},"overlay":{"musicItemThumbnailOverlayRenderer":{"content":{"musicPlayButtonRenderer":{"playNavigationEndpoint":{"watchEndpoint":{"videoId":"N1eYmYiNXYo","params":"8gEDmAEI","watchEndpointMusicSupportedConfigs":{"watchEndpointMusicConfig":{"musicVideoType":"MUSIC_VIDEO_TYPE_PODCAST_EPISODE"}}}},"playIcon":{"iconType":"PLAY_ARROW"},"pauseIcon":{"iconType":"PAUSE"},"iconColor":4294967295,"backgroundColor":0,"activeBackgroundColor":0,"loadingIndicatorColor":14745645,"playingIcon":{"iconType":"VOLUME_UP"},"iconLoadingColor":0,"activeScaleFactor":1,"buttonSize":"MUSIC_PLAY_BUTTON_SIZE_SMALL","rippleTarget":"MUSIC_PLAY_BUTTON_RIPPLE_TARGET_SELF","accessibilityPlayData":{},"accessibilityPauseData":{}}},"contentPosition":"MUSIC_ITEM_THUMBNAIL_OVERLAY_CONTENT_POSITION_CENTERED","displayStyle":"MUSIC_ITEM_THUMBNAIL_OVERLAY_DISPLAY_STYLE_PERSISTENT"}},"onTap":{"watchEndpoint":{"videoId":"N1eYmYiNXYo","params":"8gEDmAEI","watchEndpointMusicSupportedConfigs":{"watchEndpointMusicConfig":{"musicVideoType":"MUSIC_VIDEO_TYPE_PODCAST_EPISODE"}}}},"subtitle":{"runs":[{"text":"16K views"},{"text":" • "},{"text":"Aug 10"}]},"playbackProgress":{"musicPlaybackProgressRenderer":{"playbackProgressPercentage":0,"playbackProgressText":{"runs":[{"text":" • "},{"text":"48 min"}]},"videoPlaybackPositionFeedbackToken":"AB9zfpIpdRaJE9965Jbv7lgRZjOEj7ZB5uHIqSopxqMTQl1ViwqOaV51H4Fx8FsaBPO6cYGKIYQ5cOUHwXqOYX-PgC_7LDbYJg","durationText":{"runs":[{"text":" • "},{"text":"48 min"}]},"playedText":{"runs":[{"text":" • "},{"text":"Played","textColor":4294921797}]}}},"title":{"runs":[{"text":"E198 Pourquoi regardons-nous ailleurs ?","navigationEndpoint":{"browseEndpoint":{"browseId":"MPEDN1eYmYiNXYo","browseEndpointContextSupportedConfigs":{"browseEndpointContextMusicConfig":{"pageType":"MUSIC_PAGE_TYPE_NON_MUSIC_AUDIO_TRACK_PAGE"}}}}}]},"description":{"runs":[{"text":"Cet été, la France a connu des incendies dévastateurs et des canicules à répétition. Le changement climatique n'a jamais semblé aussi concret, aussi proche. Et pourtant, malgré l'ampleur de la catastrophe en cours, la plupart d'entre nous continue de vivre presque comme si de rien n'était.\n\nDans cet épisode très personnel, Hugo se livre à une introspection honnête : pourquoi lui-même, pourtant conscient depuis longtemps du réchauffement climatique, ne fait-il pas plus d'efforts pour agir ? Il explore les mécanismes psychologiques et sociétaux qui nous poussent à minimiser le danger.\n\nIl s'interroge aussi sur les responsabilités partagées entre individus, gouvernements et grandes entreprises.\n\nUn épisode sincère, sans culpabilisation ni discours moralisateur, pour trouver la motivation d'agir.\n\nRetrouvez la transcription de l'épisode sur https://innerfrench.com/e198 (https://innerfrench.com/198-pourquoi-regardons-nous-ailleurs/) \n\nRetrouvez nos cours pour améliorer votre français sur https://innerfrench.com/cours  (https://innerfrench.com/cours/?utm_source=podcast&utm_medium=organic&utm_content=e198)"}]},"displayStyle":"MUSIC_MULTI_ROW_LIST_ITEM_DISPLAY_STYLE_DETAILED"}}],"continuations":[{"nextContinuationData":{"continuation":"4qmFsgJmEiZNUFNQUEx5Y1ROTFVvMnkyRUFLRWhWZnhCOWdZbzZyME9UTWdNMBo8ZWg1UVZEcERRbEZwUlVWUk5VNTZXWGhQUlVreVRVUldSazFFWjNoT1JVMlNBUU1JMlFqYUNBUUlBaEFC","autoloadEnabled":true,"autoloadImmediately":true}}],"shelfDivider":{"musicShelfDividerRenderer":{"hidden":true}}}}],"header":{"chipCloudRenderer":{"chips":[{"chipCloudChipRenderer":{"style":{"styleType":"STYLE_ICON_SECOND"},"text":{"runs":[{"text":"Latest"}]},"navigationEndpoint":{"openPopupAction":{"popup":{"menuPopupRenderer":{"items":[{"menuNavigationItemRenderer":{"text":{"simpleText":"Latest"},"icon":{"iconType":"CHECK"},"navigationEndpoint":{"browseSectionListReloadEndpoint":{"continuation":{"reloadContinuationData":{"continuation":"4qmFsgJGEiZNUFNQUEx5Y1ROTFVvMnkyRUFLRWhWZnhCOWdZbzZyME9UTWdNMBoca2dFRENOa0lvQVlCMmdnRUNBSVFBUSUzRCUzRA%3D%3D","showSpinnerOverlay":true}},"targetId":"browse-feedMPSPPLycTNLUo2y2EAKEhVfxB9gYo6r0OTMgM0"}}}},{"menuNavigationItemRenderer":{"text":{"simpleText":"Oldest"},"navigationEndpoint":{"browseSectionListReloadEndpoint":{"continuation":{"reloadContinuationData":{"continuation":"4qmFsgJGEiZNUFNQUEx5Y1ROTFVvMnkyRUFLRWhWZnhCOWdZbzZyME9UTWdNMBoca2dFRENOa0lvQVlCMmdnRUNBRVFBUSUzRCUzRA%3D%3D","showSpinnerOverlay":true}},"targetId":"browse-feedMPSPPLycTNLUo2y2EAKEhVfxB9gYo6r0OTMgM0"}}}},{"menuNavigationItemRenderer":{"text":{"simpleText":"Popular"},"navigationEndpoint":{"browseSectionListReloadEndpoint":{"continuation":{"reloadContinuationData":{"continuation":"4qmFsgJGEiZNUFNQUEx5Y1ROTFVvMnkyRUFLRWhWZnhCOWdZbzZyME9UTWdNMBoca2dFRENOa0lvQVlCMmdnRUNBSVFBZyUzRCUzRA%3D%3D","showSpinnerOverlay":true}},"targetId":"browse-feedMPSPPLycTNLUo2y2EAKEhVfxB9gYo6r0OTMgM0"}}}},{"menuNavigationItemRenderer":{"text":{"simpleText":"Creator provided"},"navigationEndpoint":{"browseSectionListRe