 B2 (intermediate +) for solo episodes / B2-C1 for conversations between Hugo and Ingrid or interviews\n\n* with the exception of episodes 40 & 74, which are C1 (advanced)"}]},"moreButton":{"toggleButtonRenderer":{"isToggled":false,"isDisabled":false,"defaultIcon":{"iconType":"EXPAND"},"defaultText":{"runs":[{"text":"More"}]},"toggledIcon":{"iconType":"COLLAPSE"},"toggledText":{"runs":[{"text":"Less"}]}}},"shelfStyle":"MUSIC_SHELF_STYLE_OPEN_DIALOG_ON_CLICK"}}}}],"targetId":"browse-feedMPSPPLycTNLUo2y2EAKEhVfxB9gYo6r0OTMgM0_header"}}}}]}}}