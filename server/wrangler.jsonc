{
	"name": "sapoche-app",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	// No extra public URLs per version
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "Room"
			}
		]
	},
	// The web app, copied into web-dist by app/tool/web.sh. Anything that is not one of the routes of the Worker is
	// answered from here, and an address that is no file opens the app (it routes by itself)
	"assets": {
		"directory": "./web-dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/health", "/rooms", "/room/*", "/join/*", "/update/*", "/yt/*", "/push/*", "/.well-known/*"]
	},
	// Releases of the app, for updates from inside it. Create it first: wrangler r2 bucket create sapoche-releases
	"r2_buckets": [
		{
			"binding": "RELEASES",
			"bucket_name": "sapoche-releases"
		}
	],
	// Free plan only supports SQLite-backed Durable Objects
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Room"
			]
		}
	]
}